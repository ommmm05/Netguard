# ==============================================================================
# NetGuard .gitignore
# ==============================================================================

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend Build
node_modules/
dist/
dist-ssr/
*.local

# Python caches & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
develop-eggs/
downloads/
eggs/
.installed.cfg
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Testing & Linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# Runtime databases & local data
data/*.db
data/*.db-*
*.sqlite
*.sqlite3
data/netguard.db

# Network captures & PCAP recordings (Preserve sample demo fixtures only)
*.pcap
*.pcapng
data/captures/*
!data/captures/.gitkeep
!data/sample/demo.pcap

# Uploads directory contents
data/uploads/*
!data/uploads/.gitkeep

# CICIDS2017 Dataset CSVs & large dataset uploads
data/cicids_uploads/*
!data/cicids_uploads/.gitkeep
*.csv
!tests/**/*.csv
!data/sample/**/*.csv

# Model artifacts (Large / reproducible binaries generated by trainer)
data/models/*.joblib
data/models/*.pkl
data/models/*.h5
data/models/*.pt
data/models/*.onnx
!data/models/.gitkeep
!data/models/model_meta.json

# Generated reports & Incident PDFs
*.pdf
!docs/**/*.pdf
reports/

# Environment files & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.token
*.secret
credentials.json
service_account.json

# Logs & temporary files
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo

# OS & IDE caches
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Packaging & Archives
releases/
*.zip
*.tar.gz
*.gz
*.7z
*.rar
!docs/**/*.zip
